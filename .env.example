# Configuración de variables de entorno para Vite
# Copia este archivo como .env y coloca tus valores reales

# Endpoint base de la API de tipo de cambio
# Endpoint gratuito sin requerir registro previo: https://open.er-api.com/v6/latest
VITE_API_URL=https://open.er-api.com/v6/latest

# Tu API Key (Dejar con valor ficticio o vacío si usas open.er-api.com, o tu key de exchangerate-api)
VITE_API_KEY=tu_api_key_secreta_aqui
